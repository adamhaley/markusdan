# Copy these values into the server's untracked .env file.
# Do not commit the real .env file.

WORDPRESS_ADMIN_PASSWORD=replace-with-a-random-password
WORDPRESS_ADMIN_EMAIL=admin@example.com
MARIADB_ROOT_PASSWORD=replace-with-a-random-password

# Required by the render-service Compose entry when it is added.
RSC_VIMEO_ACCESS_TOKEN=replace-with-vimeo-token
RSC_RENDER_API_KEY=replace-with-a-random-api-key
RSC_TRANSITION_DURATION=0.35
