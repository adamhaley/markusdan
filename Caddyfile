dashboard.megyk.com {
    reverse_proxy megyk-dashboard:3100
}

pdf.megyk.com {
    reverse_proxy html2pdf:8000
}

app.megyk.com {
    reverse_proxy megyk-books:3200
}

staging.megyk.com {
   reverse_proxy megyk-books-staging:3200
}

megyk.com {
   reverse_proxy wordpress:8080
}

# Ollama
ollama.megyk.com {
    reverse_proxy 172.17.0.1:11434 {
	transport http {
            # These extend the default timeouts for long-running requests
            dial_timeout 30s
            response_header_timeout 900s
            read_timeout 900s
            write_timeout 900s
        }
    }
}
