# Root URL -> quiz start. A real edge redirect instead of index.html's old
# meta-refresh, which caused a brief flash of unstyled content before
# navigating. Target is the canonical extensionless URL (GA4 records
# /schritt-1.html and /schritt-1 as separate paths otherwise).
/            /schritt-1  301
/index.html  /schritt-1  301

# .html requests -> canonical extensionless URL, so any old bookmarked/
# indexed .html link converges on the same GA4 page path as internal nav.
/schritt-1.html  /schritt-1  301
/schritt-2.html  /schritt-2  301
/schritt-3.html  /schritt-3  301
/schritt-4.html  /schritt-4  301
/schritt-5.html  /schritt-5  301
/schritt-6.html  /schritt-6  301
/auswertung.html /auswertung 301

# 2026-09-24: the two warm-up questions (schritt-1/1b) were dropped and
# real estate (formerly schritt-1c) renumbered down to schritt-1. Stale
# links to the old intro steps land on the new first question instead of
# 404ing. Splat handles both extensionless and .html-suffixed forms in one
# hop, same as the /variante-b/ rule below.
/schritt-1b*  /schritt-1  301
/schritt-1c*  /schritt-1  301

# Old English step URLs -> current German schritt URLs.
# Cloudflare Pages reads this file automatically on every deploy.
/step-1.html  /schritt-1  301
/step-2.html  /schritt-2  301
/step-3.html  /schritt-3  301
/step-4.html  /schritt-4  301
/step-5.html  /schritt-5  301
/step-6.html  /schritt-6  301

# schritt-7 (optional feedback step) was deprecated; schritt-6 now submits
# directly. Send any stale links to the end of the live flow instead of 404s.
/step-7.html    /schritt-6  301
/schritt-7.html /schritt-6  301

# Variant B (branching flow A/B test) -- lives at /schnellcheck/ rather than
# /variante-b/ per client request (2026-09-17). Same .html -> extensionless
# canonicalization as the Variant A pages above.
/schnellcheck/schritt-1.html   /schnellcheck/schritt-1   301
/schnellcheck/schritt-1b.html  /schnellcheck/schritt-1b  301
/schnellcheck/schritt-2.html   /schnellcheck/schritt-2   301
/schnellcheck/schritt-2a.html  /schnellcheck/schritt-2a  301
/schnellcheck/schritt-3.html   /schnellcheck/schritt-3   301
/schnellcheck/schritt-3a.html  /schnellcheck/schritt-3a  301
/schnellcheck/schritt-4.html   /schnellcheck/schritt-4   301
/schnellcheck/schritt-4a.html  /schnellcheck/schritt-4a  301
/schnellcheck/schritt-5.html   /schnellcheck/schritt-5   301
/schnellcheck/schritt-5a.html  /schnellcheck/schritt-5a  301
/schnellcheck/schritt-6.html   /schnellcheck/schritt-6   301
/schnellcheck/schritt-6a.html  /schnellcheck/schritt-6a  301
/schnellcheck/schritt-7.html   /schnellcheck/schritt-7   301
/schnellcheck/schritt-7a.html  /schnellcheck/schritt-7a  301
/schnellcheck/auswertung.html  /schnellcheck/auswertung  301

# Old /variante-b/ path -- redirect to the renamed /schnellcheck/ path in
# case it was already shared/bookmarked before the rename. Verified this
# splat handles both extensionless and .html-suffixed old links in a
# single hop (Cloudflare normalizes .html before matching _redirects).
/variante-b/*  /schnellcheck/:splat  301
